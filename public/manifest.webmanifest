{
  "name": "MyDay",
  "short_name": "MyDay",
  "description": "轻量的每日计划、复盘和数据统计工具。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#f4f7f9",
  "theme_color": "#10aab2",
  "categories": ["productivity", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./myday-icon-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./myday-icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./myday-icon-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./myday-icon-1024-v2.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
